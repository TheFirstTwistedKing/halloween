# 이 파일을 복사해서 .env로 만들고 값을 채우세요. (.env는 저장소에 올라가지 않아요)

# 봇 토큰 (개발자 포털 → Bot → Reset Token). 채팅·스크린샷·깃허브에 절대 올리지 마세요.
DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# 봇을 쓸 서버 ID. 비워 두면 봇이 들어간 모든 서버에 등록되는데 반영까지 최대 1시간 걸려요.
# 여러 서버는 쉼표로 구분해요. 예: 111111111111111111,222222222222222222
GUILD_ID=

# 데이터(재화·가방·상점·던전 진행)를 저장할 파일. 비우면 data/halloween.sqlite3
DATABASE_PATH=data/halloween.sqlite3

# /역할재화지급(역할을 가진 모든 사람에게 재화 지급)을 쓰려면 true.
# 켜기 전에 개발자 포털 → Bot 탭에서 Server Members Intent를 먼저 켜야 해요.
# 포털에서 Server Members Intent를 켜지 않고 true로 하면 봇이 시작되지 않아요. 안 쓸 거면 비워 두세요.
MEMBERS_INTENT=
